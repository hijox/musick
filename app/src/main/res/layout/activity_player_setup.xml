<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_3"
    android:fitsSystemWindows="true"
    tools:context=".PlayerSetupActivity">

    <!-- Back Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        android:contentDescription="Back"
        android:src="@drawable/ic_arrow_back"
        app:layout_anchor="@id/scrollView"
        app:layout_anchorGravity="top|start"
        app:backgroundTint="@color/surface"
        app:tint="@color/text_primary"
        app:fabSize="mini"
        app:elevation="4dp" />

    <!-- Main Content ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_lg"
            android:minHeight="200dp">

            <!-- Content Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/content_max_width"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="0.1">

                <!-- Header Section -->
                <TextView
                    android:id="@+id/setupTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Player Setup"
                    android:textColor="@color/spotify_green"
                    android:textAppearance="@style/TextAppearance.Musick.DisplayMedium"
                    android:layout_marginTop="@dimen/spacing_xxl"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/setupDescriptionTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Enter the number of players and their names to get started"
                    android:textAppearance="@style/TextAppearance.Musick.BodyLarge"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:layout_constraintTop_toBottomOf="@id/setupTitleTextView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Player Count Input Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/playerCountCard"
                    style="@style/Widget.Musick.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    app:layout_constraintTop_toBottomOf="@id/setupDescriptionTextView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Number of Players"
                            android:textAppearance="@style/TextAppearance.Musick.TitleLarge"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="@dimen/spacing_md" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/playerCountInputLayout"
                            style="@style/Widget.Musick.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter number (2-8)"
                            app:startIconDrawable="@drawable/ic_settings"
                            app:startIconTint="@color/spotify_green">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/playerCountInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:imeOptions="actionNext"
                                android:textColor="@color/text_primary"
                                android:textAppearance="@style/TextAppearance.Musick.BodyLarge" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Player Names Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/playerNamesCard"
                    style="@style/Widget.Musick.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/playerCountCard"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Player Names"
                            android:textAppearance="@style/TextAppearance.Musick.TitleLarge"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="@dimen/spacing_md" />

                        <LinearLayout
                            android:id="@+id/playerNamesLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Start Game Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startGameButton"
                    style="@style/Widget.Musick.Button.Large"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:layout_marginBottom="@dimen/spacing_xl"
                    android:text="Start Game"
                    android:enabled="false"
                    app:icon="@drawable/play"
                    app:iconGravity="textStart"
                    app:layout_constraintTop_toBottomOf="@id/playerNamesCard"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>